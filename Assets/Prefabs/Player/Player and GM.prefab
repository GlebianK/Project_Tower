    - target: {fileID: 6083304711573181366, guid: 4ad637adae4759a4fbdc0666fb90f310, type: 3}
      propertyPath: m_text
      value: "\u041B\u0451\u0433\u043A\u0438\u0439: \u0432\u0432\u043E\u0434\u0438\u0442\u0441\u044F
        \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u044F
        \u043E\u0442 \u0442\u044F\u0436\u0451\u043B\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430\n\n\u0429\u0438\u0442\u043E\u0432\u0438\u043A:
        \u043D\u0435 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442\u0441\u044F.
        \u041D\u0430\u043D\u0435\u0441\u0438\u0442\u0435 \u0434\u0432\u0430 \u0442\u044F\u0436\u0451\u043B\u044B\u0445
        \u0443\u0434\u0430\u0440\u0430, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u0438\u0442\u044C
        \u0449\u0438\u0442 \u0438 \u0441\u043D\u044F\u0442\u044C \u0438\u043C\u043C\u0443\u043D\u0438\u0442\u0435\u0442
        \u043A \u043B\u0451\u0433\u043A\u0438\u043C \u0430\u0442\u0430\u043A\u0430\u043C"
      objectReference: {fileID: 0}

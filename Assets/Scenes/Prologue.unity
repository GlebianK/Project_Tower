--- !u!114 &1882000462
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1882000457}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58295645998a01240a9473984ab787a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  taskPanelObject: {fileID: 1518659902}
  panelObject: {fileID: 60940080}
  panels:
  - scenarioText: "\u0412 \u0442\u043E\u0442 \u0434\u0435\u043D\u044C \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
      \u0432\u0441\u0451. \u0421\u043E\u043B\u043D\u0446\u0435, \u043D\u0435\u043A\u043E\u0433\u0434\u0430
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0436\u0438\u0437\u043D\u0438,
      \u0441\u0442\u0430\u043B\u043E \u043D\u0430\u0448\u0438\u043C \u0437\u043B\u0435\u0439\u0448\u0438\u043C
      \u0432\u0440\u0430\u0433\u043E\u043C. \u0422\u0435, \u043A\u0442\u043E \u043D\u0435
      \u0443\u0441\u043F\u0435\u043B \u0443\u043A\u0440\u044B\u0442\u044C\u0441\u044F,
      \u0438\u0441\u0447\u0435\u0437\u043B\u0438, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0431\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u043D\u0438 \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445.
      \u0413\u043E\u0440\u043E\u0434\u0430 \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0432 \u043F\u0443\u0441\u0442\u043E\u0448\u0438, \u0441\u043A\u0430\u043B\u044B
      \u043E\u0431\u0443\u0433\u043B\u0438\u043B\u0438\u0441\u044C, \u0430 \u0440\u0435\u043A\u0438
      \u0438\u0441\u043F\u0430\u0440\u0438\u043B\u0438\u0441\u044C. \u0421 \u0442\u0435\u0445
      \u043F\u043E\u0440 \u043D\u0438\u043A\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u044B
      \u043A \u043D\u0435\u0431\u0443."
    background: {fileID: 21300000, guid: 797cc6f3de6fb5d44b3591ad5dc002e4, type: 3}
  - scenarioText: "\u041F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F \u0441\u0442\u0430\u043B\u0438
      \u043D\u0430\u0448\u0438\u043C \u0434\u043E\u043C\u043E\u043C. \u0412 \u0441\u0442\u0430\u0440\u044B\u0445
      \u043A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F\u0445 \u0438
      \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u043E\u0440\u0430\u0445 \u043B\u044E\u0434\u0438
      \u043D\u0430\u0448\u043B\u0438 \u043D\u043E\u0432\u0443\u044E \u0436\u0438\u0437\u043D\u044C:
      \u043D\u0430\u043B\u043E\u0432\u0447\u0438\u043B\u0438\u0441\u044C \u0441\u0431\u0438\u0432\u0430\u0442\u044C
      \u043B\u0430\u0447\u0443\u0433\u0438 \u0438\u0437 \u043C\u0443\u0441\u043E\u0440\u0430,
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432 \u043B\u0430\u0433\u0435\u0440\u044F,
      \u0441\u0442\u0430\u043B\u0438 \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438. \u0417\u0434\u0435\u0441\u044C
      \u043D\u0435\u0442 \u043D\u0438 \u0434\u043D\u044F, \u043D\u0438 \u043D\u043E\u0447\u0438
      \u2014 \u0435\u0441\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0447\u043D\u044B\u0439
      \u0441\u044B\u0440\u043E\u0439 \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A,
      \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C
      \u2014 \u0431\u043E\u0440\u044C\u0431\u0430 \u0437\u0430 \u043A\u0443\u0441\u043E\u043A
      \u0445\u043B\u0435\u0431\u0430 \u0438 \u0433\u043B\u043E\u0442\u043E\u043A
      \u0447\u0438\u0441\u0442\u043E\u0439 \u0432\u043E\u0434\u044B. \u041C\u044B
      \u0432\u044B\u0436\u0438\u043B\u0438... \u0410 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0435\u0449\u0451 \u043D\u0435 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438."
    background: {fileID: 21300000, guid: 5918c761a88fd1b478d9055af33afd1b, type: 3}
  - scenarioText: "\u041F\u043E\u043A\u0430 \u043E\u0434\u043D\u0438 \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F,
      \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0434\u0443\u0442 \u0432\u043F\u0435\u0440\u0451\u0434.
      \u0421\u0432\u044F\u0437\u0443\u044E\u0449\u0430\u044F \u043D\u0438\u0442\u044C
      \u043C\u0435\u0436\u0434\u0443 \u043B\u0430\u0433\u0435\u0440\u044F\u043C\u0438
      \u2014 \u041F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D\u044B. \u0418
      \u044F \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445. \u0418\u0437
      \u043B\u0430\u0433\u0435\u0440\u044F \u0432 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043C\u044B \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C \u043D\u043E\u0432\u043E\u0441\u0442\u0438,
      \u043F\u043E\u0441\u044B\u043B\u043A\u0438, \u043F\u0440\u0438\u043F\u0430\u0441\u044B...
      \u0438, \u0435\u0441\u043B\u0438 \u043F\u043E\u0432\u0435\u0437\u0451\u0442,
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0432\u044B\u0445\u043E\u0434 \u0432
      \u0442\u0451\u043C\u043D\u044B\u0435, \u043C\u0430\u043B\u043E\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0442\u0443\u043D\u043D\u0435\u043B\u0438 \u2014 \u043A\u0430\u043A \u043F\u0440\u044B\u0436\u043E\u043A
      \u0432 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C. 
      \u041D\u043E \u0435\u0441\u043B\u0438 \u043C\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C\u0441\u044F,
      \u043C\u0438\u0440 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0442\u0441\u044F \u0432 \u0431\u0435\u0437\u0434\u043D\u0443."
    background: {fileID: 21300000, guid: f821dcd165cf50443ac8379a495ba16d, type: 3}
  - scenarioText: "\u0414\u043E\u0440\u043E\u0433\u0430 \u043F\u043E\u043B\u043D\u0430
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439. \u041E\u043F\u0430\u0441\u0430\u0442\u044C\u0441\u044F
      \u043D\u0443\u0436\u043D\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0431\u0432\u0430\u043B\u043E\u0432, \u0442\u0443\u043F\u0438\u043A\u043E\u0432
      \u0438 \u043A\u043E\u0435-\u0433\u0434\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0449\u0438\u0445\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0442\u043E\u043B\u0449\u0443 \u0437\u0435\u043C\u043B\u0438
      \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0445 \u043B\u0443\u0447\u0435\u0439,
      \u043D\u043E \u0438 \u0436\u0438\u0432\u044B\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432.
      \u0411\u0430\u043D\u0434\u044B, \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0438,
      \u043F\u0430\u0434\u0430\u043B\u044C\u0449\u0438\u043A\u0438... \u0418\u043C
      \u043D\u0443\u0436\u043D\u044B \u0442\u0432\u043E\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u0442\u0432\u043E\u0439 \u0433\u0440\u0443\u0437 \u0438 \u0442\u0432\u043E\u044F
      \u0436\u0438\u0437\u043D\u044C. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043F\u0443\u0442\u044C \u0434\u043E \u0446\u0435\u043B\u0435\u0432\u043E\u0433\u043E
      \u043B\u0430\u0433\u0435\u0440\u044F \u0438\u043D\u043E\u0433\u0434\u0430 \u0435\u0449\u0451
      \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E\u043B\u043E\u0436\u0438\u0442\u044C. \u0412 \u044D\u0442\u043E\u043C
      \u043C\u0438\u0440\u0435 \u2014 \u043A\u0442\u043E \u043D\u0435 \u0434\u0435\u0440\u0451\u0442\u0441\u044F,
      \u0442\u043E\u0442 \u0443\u0436\u0435 \u043C\u0451\u0440\u0442\u0432, \u0438
      \u043C\u044B \u0437\u043D\u0430\u0435\u043C \u044D\u0442\u043E \u043A\u0430\u043A
      \u043D\u0438\u043A\u0442\u043E."
    background: {fileID: 21300000, guid: d2c934091a7fa3343838751d127657b8, type: 3}
